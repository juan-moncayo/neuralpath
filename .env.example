# ─── Base de datos Turso ───────────────────────────────────────────
DATABASE_URL="libsql://tu-base.region.turso.io"
DATABASE_AUTH_TOKEN="tu-auth-token-de-turso"

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth.js v5 ────────────────────────────────────────────────
AUTH_SECRET="genera-con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────────────
AUTH_GOOGLE_ID="tu-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# ─── Resend (emails) ───────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="NeuralPath <no-reply@neuralpath.co>"

# ─── URLs de las apps ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_CURSOS_URL="http://localhost:3001"
NEXT_PUBLIC_API_MENTOR_URL="http://localhost:3002"

# ─── API Cursos (Fastify) ──────────────────────────────────────────
API_CURSOS_PORT=3001
API_CURSOS_JWT_SECRET="jwt-secret-para-api-cursos-muy-seguro"

# ─── Mux (videos) ─────────────────────────────────────────────────
MUX_TOKEN_ID="tu-mux-token-id"
MUX_TOKEN_SECRET="tu-mux-token-secret"

# ─── OpenAI (MentorAI) ────────────────────────────────────────────
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── ElevenLabs (TTS MentorAI) ────────────────────────────────────
ELEVENLABS_API_KEY="tu-elevenlabs-api-key"

# ─── Wompi (pagos COP) ────────────────────────────────────────────
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="tu-wompi-events-secret"
