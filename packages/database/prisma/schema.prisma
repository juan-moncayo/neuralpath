generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  googleId     String?  @unique
  role         String   @default("parent")
  plan         String   @default("free")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children      ChildProfile[]
  subscriptions Subscription[]
  payments      PaymentCop[]
  courses       Course[]
}

model ChildProfile {
  id          String   @id @default(cuid())
  parentId    String
  name        String
  age         Int
  avatarEmoji String   @default("👦")
  interests   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      User            @relation(fields: [parentId], references: [id])
  enrollments Enrollment[]
  chatMessages ChatMessage[]
  sessions    MentorSession[]
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  plan        String
  status      String
  wompiId     String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Course {
  id           String   @id @default(cuid())
  instructorId String
  title        String
  description  String
  category     String
  ageMin       Int
  ageMax       Int
  priceCop     Int
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor  User         @relation(fields: [instructorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  videoUrl     String?
  muxAssetId   String?
  durationSecs Int      @default(0)
  order        Int
  transcript   String?
  isFree       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course        @relation(fields: [courseId], references: [id])
  chatMessages ChatMessage[]
}

model Enrollment {
  id             String    @id @default(cuid())
  childId        String
  courseId       String
  progressPct    Int       @default(0)
  completedAt    DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  child  ChildProfile @relation(fields: [childId], references: [id])
  course Course       @relation(fields: [courseId], references: [id])
}

model PaymentCop {
  id        String    @id @default(cuid())
  userId    String
  amountCop Int
  plan      String?
  courseId  String?
  method    String
  wompiRef  String    @unique
  status    String
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  childId    String
  lessonId   String
  role       String
  content    String
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  child  ChildProfile @relation(fields: [childId], references: [id])
  lesson Lesson       @relation(fields: [lessonId], references: [id])
}

model Mentor {
  id             String   @id @default(cuid())
  name           String
  specialty      String
  ageMin         Int
  ageMax         Int
  avatarVideoUrl String
  voiceId        String
  systemPrompt   String
  emoji          String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions MentorSession[]
}

model MentorSession {
  id           String    @id @default(cuid())
  childId      String
  mentorId     String
  status       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationSecs Int       @default(0)
  scoreTotal   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  child    ChildProfile     @relation(fields: [childId], references: [id])
  mentor   Mentor           @relation(fields: [mentorId], references: [id])
  feedback SessionFeedback?
}

model SessionFeedback {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  strengths       String
  improvements    String
  recommendations String
  sentToParentAt  DateTime?
  createdAt       DateTime  @default(now())

  session MentorSession @relation(fields: [sessionId], references: [id])
}
